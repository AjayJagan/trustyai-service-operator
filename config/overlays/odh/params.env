trustyaiServiceImage=quay.io/redhat-user-workloads/open-data-hub-tenant/trustyai-explainability-service-multi-arch-poc:konflux-multi-arch
trustyaiOperatorImage=quay.io/redhat-user-workloads/open-data-hub-tenant/trustyai-service-operator-multi-arch-poc:konflux-multi-arch
oauthProxyImage=quay.io/openshift/origin-oauth-proxy:4.14.0
kServeServerless=enabled
lmes-driver-image=quay.io/redhat-user-workloads/open-data-hub-tenant/lmes-eval-driver-multi-arch-poc:konflux-multi-arch
lmes-pod-image=quay.io/redhat-user-workloads/open-data-hub-tenant/lm-evaluation-harness-multi-arch-poc:konflux-multi-arch
lmes-pod-checking-interval=10s
lmes-image-pull-policy=Always
lmes-max-batch-size=24
lmes-default-batch-size=8
lmes-detect-device=true
lmes-allow-online=true
lmes-allow-code-execution=true
guardrails-orchestrator-image=quay.io/redhat-user-workloads/open-data-hub-tenant/fms-guardrails-orchestrator-multi-arch-poc:konflux-multi-arch
guardrails-built-in-detector-image=quay.io/redhat-user-workloads/open-data-hub-tenant/guardrails-regex-detector-multi-arch-poc:konflux-multi-arch
guardrails-sidecar-gateway-image=quay.io/redhat-user-workloads/open-data-hub-tenant/vllm-orchestrator-gateway-multi-arch-poc:konflux-multi-arch
